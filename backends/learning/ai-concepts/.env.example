# Copy to .env and fill in. Every script in this module reads from here.
# .env is gitignored at the repo root — never commit real keys.

# --- API keys -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Only needed for the embeddings/ and rag/ modules (Anthropic-recommended embeddings).
VOYAGE_API_KEY=pa-...

# --- Models (override to control cost) ------------------------------------
# Every script falls back to these same two if the variables are unset, so you
# only need them here to change something.
#
# The defaults are the cheap tier on purpose: you are running these to watch an
# API work, not to benchmark a model, and working through the whole module on a
# flagship model costs real money for no extra insight.
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-5.4-mini

# Swap in a more capable model when a script's output is the thing you are
# studying — the evaluation/ and tool-use/ demos are the ones where it shows.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.6-terra

# Embeddings models
OPENAI_EMBED_MODEL=text-embedding-3-small
VOYAGE_EMBED_MODEL=voyage-3
